<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock Outer Dial Subtle Glow -->
    <path
        android:pathData="M54,54m-27,0a27,27 0 1,1 54,0a27,27 0 1,1 -54,0"
        android:fillColor="#151E2E"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8" />

    <!-- Secondary Inner Track -->
    <path
        android:pathData="M54,54m-23,0a23,23 0 1,1 46,0a23,23 0 1,1 -46,0"
        android:strokeWidth="0.8"
        android:strokeColor="#334155" />

    <!-- 12 O'Clock Marker (Top) -->
    <path
        android:pathData="M54,30.5 L54,34.5"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- 3 O'Clock Marker (Right) -->
    <path
        android:pathData="M77.5,54 L73.5,54"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- 6 O'Clock Marker (Bottom) -->
    <path
        android:pathData="M54,77.5 L54,73.5"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- 9 O'Clock Marker (Left) -->
    <path
        android:pathData="M30.5,54 L34.5,54"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- Intermediate Hour Marker Dots (1, 2, 4, 5, 7, 8, 10, 11) -->
    <!-- 1 o'clock: 54 + 21*sin(30°) = 64.5, 54 - 21*cos(30°) = 35.8 -->
    <path android:pathData="M64.5,35.8m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 2 o'clock: 54 + 21*sin(60°) = 72.2, 54 - 21*cos(60°) = 43.5 -->
    <path android:pathData="M72.2,43.5m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 4 o'clock: 54 + 21*sin(120°) = 72.2, 54 + 21*cos(60°) = 64.5 -->
    <path android:pathData="M72.2,64.5m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 5 o'clock: 54 + 21*sin(150°) = 64.5, 54 + 21*cos(30°) = 72.2 -->
    <path android:pathData="M64.5,72.2m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 7 o'clock: 54 - 21*sin(150°) = 43.5, 54 + 21*cos(30°) = 72.2 -->
    <path android:pathData="M43.5,72.2m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 8 o'clock: 54 - 21*sin(120°) = 35.8, 54 + 21*cos(60°) = 64.5 -->
    <path android:pathData="M35.8,64.5m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 10 o'clock: 54 - 21*sin(60°) = 35.8, 54 - 21*cos(60°) = 43.5 -->
    <path android:pathData="M35.8,43.5m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />
    <!-- 11 o'clock: 54 - 21*sin(30°) = 43.5, 54 - 21*cos(30°) = 35.8 -->
    <path android:pathData="M43.5,35.8m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0" android:fillColor="#64748B" />

    <!-- Hour Hand (pointing to 10:10 -> 10 o'clock angle ~ 300 deg: dx = -11, dy = -6.5) -->
    <path
        android:pathData="M54,54 L43,45"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Minute Hand (pointing to ~2 o'clock angle ~ 60 deg: dx = +15, dy = -9) -->
    <path
        android:pathData="M54,54 L69,43"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- Second Hand (Cyan Accent Needle with counter-balance) -->
    <path
        android:pathData="M54,58 L54,34"
        android:strokeWidth="1.2"
        android:strokeColor="#06B6D4"
        android:strokeLineCap="round" />

    <!-- Center Pivot Ring & Cap -->
    <path
        android:pathData="M54,54m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#06B6D4" />
    <path
        android:pathData="M54,54m-1.5,0a1.5,1.5 0 1,1 3,0a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#FFFFFF" />

</vector>
